# IMDS (169.254.169.254) serves managed identity tokens.
# E2B blocks private and link-local ranges inside each sandbox's network namespace, but
# WireServer's address is public. E2B names its sandbox veths veth-N; Docker's have no hyphen.
table inet hibernaut-sandboxes
delete table inet hibernaut-sandboxes

table inet hibernaut-sandboxes {
	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "veth-*" ip daddr { 168.63.129.16, 169.254.169.254 } counter drop
	}
}
