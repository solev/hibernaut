# Keeps machines away from Azure's platform endpoints: WireServer (168.63.129.16) hands out the
# VM's certificates and extension settings, and IMDS (169.254.169.254) its managed identity's
# tokens. E2B blocks private and link-local ranges inside each sandbox's network namespace, but
# WireServer's address is public. A machine's TCP leaves through the orchestrator's egress proxy,
# which IPAddressDeny= in e2b-orchestrator.service covers; the host forwards everything else, and
# this table drops it. E2B names its sandbox veths veth-N; Docker's have no hyphen.
table inet hibernaut-sandboxes
delete table inet hibernaut-sandboxes

table inet hibernaut-sandboxes {
	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "veth-*" ip daddr { 168.63.129.16, 169.254.169.254 } counter drop
		# Machine links' addresses. Nothing machines send to them is ever forwarded: hibd proxy
		# redirects link TCP before routing, and anything else, or TCP the redirect misses, is
		# dropped here.
		iifname "veth-*" ip daddr 198.18.0.0/15 counter drop
	}
}
