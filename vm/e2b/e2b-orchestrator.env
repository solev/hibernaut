# E2B's storage, moved out of the repo checkout (packages/orchestrator/tmp). Overrides .env.local.
ORCHESTRATOR_BASE_PATH=/var/lib/e2b
ORCHESTRATOR_LOCK_PATH=/var/lib/e2b/.lock
LOCAL_BUILD_CACHE_STORAGE_BASE_PATH=/var/lib/e2b/local-build-cache
LOCAL_TEMPLATE_STORAGE_BASE_PATH=/var/lib/e2b/local-template-storage
SANDBOX_CACHE_DIR=/var/lib/e2b/sandbox-cache-dir
# How long E2B waits for envd when a machine resumes, up from 10s. The orchestrator's snapshot
# cache is empty after it starts, so a machine's first resume then waits while its memory is
# copied back in. For a 2 GiB machine in use for days that took 13s to 32s. E2B gives its own
# cold paths 60s, and its API ends a request after 70s.
ENVD_TIMEOUT=60s
