#!/usr/bin/env bash
set -euo pipefail

IDLE_MINUTES="${IDLE_MINUTES:-30}"
MAX_LOAD="${MAX_LOAD:-1.0}"
STATE_FILE="${STATE_FILE:-/run/idle-deallocate/last-active}"
HIBD="${HIBD:-/usr/local/bin/hibd}"
QUIESCE="${QUIESCE:-/usr/local/lib/hibernaut/quiesce}"
DEALLOCATE="${DEALLOCATE:-/usr/local/lib/hibernaut/deallocate-self}"
LOADAVG_FILE="${LOADAVG_FILE:-/proc/loadavg}"
# Session processes are named "sshd: user@pts/0", "sshd: user@notty", or "sshd: user" for
# `ssh -N` tunnels ("sshd-session:" from OpenSSH 9.8). The listener and "[priv]" ones don't match.
default_ssh_session_pattern='^sshd(-session)?: [^ [@]+(@[^ ]+)?$'
SSH_SESSION_PATTERN="${SSH_SESSION_PATTERN:-$default_ssh_session_pattern}"

now=$(date +%s)
mkdir -p "$(dirname "$STATE_FILE")"
[[ -f "$STATE_FILE" ]] || echo "$now" >"$STATE_FILE"

active() {
  echo "$now" >"$STATE_FILE"
  exit 0
}

if pgrep -f "$SSH_SESSION_PATTERN" >/dev/null; then
  active
fi

load=$(cut -d' ' -f1 "$LOADAVG_FILE")
if awk -v l="$load" -v m="$MAX_LOAD" 'BEGIN { exit !(l >= m) }'; then
  active
fi

if [[ -x "$HIBD" ]]; then
  if ! running=$("$HIBD" ls --state running -q); then
    echo "Can't list machines; counting that as activity"
    active
  fi
  if [[ -n "$running" ]]; then
    active
  fi
fi

idle_seconds=$(( now - $(cat "$STATE_FILE") ))
if (( idle_seconds < IDLE_MINUTES * 60 )); then
  exit 0
fi

if ! "$QUIESCE"; then
  echo "Couldn't pause every machine; not deallocating"
  exit 1
fi
exec "$DEALLOCATE" "idle for ${idle_seconds}s: no SSH session, no running machine, load $load"
