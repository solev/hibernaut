[Unit]
Description=Hibernaut daemon: keeps busy machines running and cleans up their snapshots
After=e2b-infra.service e2b-api.service e2b-orchestrator.service e2b-client-proxy.service

[Service]
EnvironmentFile=/etc/hibernaut/hibd.env
ExecStart=/usr/local/bin/hibd daemon
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/e2b/local-template-storage
ReadWritePaths=/var/lib/hibernaut

[Install]
WantedBy=multi-user.target
