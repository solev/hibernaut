[Unit]
Description=Hibernaut secret egress proxy
After=e2b-infra.service e2b-api.service e2b-orchestrator.service e2b-client-proxy.service

[Service]
User=root
EnvironmentFile=/etc/hibernaut/hibd.env
ExecStart=/usr/local/bin/hibd proxy
ExecStopPost=/usr/local/bin/hibd proxy -unhook
Restart=always
RestartSec=2
TimeoutStopSec=30
# A link guard Keeper starved for longer than GuardTTL - GuardKeep shuts every link.
CPUWeight=200
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/hibernaut
# The link control socket, the guard's token file and the quiescing marker. Not
# RuntimeDirectory=, which systemd deletes on stop, marker and all: hibernaut-tmpfiles.conf
# creates it at boot. Never ProtectKernelTunables=, which would stop the link guard from setting
# net.ipv4.tcp_fwmark_accept.
ReadWritePaths=/run/hibernaut
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
LogsDirectory=hibernaut
LogsDirectoryMode=0755
UMask=0022

[Install]
WantedBy=multi-user.target
